Algoritmo taller17
	
definir lado1,lado2 como real;

escribir"ingrese el valor del lado a";
leer lado1;
escribir" ingrese el valor del lado b";
leer lado2;

P<-2*lado1+ 2*lado2;
escribir"el resultado del perímetro es:", P;

A<-lado1*lado2;
escribir"el resultado del área es:", A;


FinAlgoritmo
