Algoritmo taller9
definir tarifa,preciopagado como entero;
definir descuento,porcentaje como real;

escribir "ingrese el precio de la tarifa";
leer tarifa;

escribir"ingrese el precio pagado";
leer preciopagado;

descuento<-tarifa-preciopagado;
escribir "el descuento de la compra es de:",descuento;

porcentaje<-descuento/tarifa*(100);
escribir"el porcentaje de descuento es:",porcentaje;


	
FinAlgoritmo
