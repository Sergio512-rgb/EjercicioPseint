Algoritmo ejercicio3
	Definir num1,num2,num3,num4 Como real;
	Definir suma,promedio Como Real;
	Escribir "digite el num1";
	Leer num1;
	Escribir "digite el num2";
	Leer num2;
	Escribir "digite el num3";
	Leer num3;
	Escribir "digite el num4";
	Leer num4;
	suma<-num1+num2+num3+num4;
	promedio<-suma/4;
	Escribir "la suma de los numeros es:", suma;
	Escribir "el promedio de los numeros es:", promedio;
	
	
	
FinAlgoritmo
