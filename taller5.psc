Algoritmo taller5
definir lado1,lado2,lado3,perimetro como entero;

escribir"digite el primer lado";
leer lado1;
escribir"digite el segundo lado";
leer lado2;
escribir"digite el tercer lado";
leer lado3;

perimetro<-lado1+lado2+lado3;
escribir"el perímetro es:", perimetro;
FinAlgoritmo
