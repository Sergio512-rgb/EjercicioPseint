Algoritmo taller11
definir num1,num2,suma,resta,multiplicacion,division, modulo Como real;

escribir "digite el primer numero";
leer num1;
escribir "digite el segundo numero";
leer num2;
//AHORA VAMOS A REALIZAR LA SUMA DE LOS NUMEROS
suma<-num1+num2;
Escribir "la suma de los numeros es:", suma;

resta<-num1-num2;
escribir "la resta de los numeros es:", resta;

multiplicacion<-num1*num2;
escribir "la multiplicacion de los numeros es:", multiplicacion;

division<-num1/num2;
Escribir "la division de los numeros es:", division;

modulo<-num1 MOD num2;
escribir "el módulo de los números es:", modulo;

FinAlgoritmo

